<!-- begin:ubytovani -->

<!-- begin:konec -->
<p>Možnost objednávek ubytování přes web už skončila. Zbylé postele lze zarezervovat přes e-mail <a
        href="mailto:info@gamecon.cz">info@gamecon.cz</a>.</p>
<!-- end:konec -->

<!-- begin:nechciUbytovani -->
<div class="shopUbytovani_nechci" style="display: {displayNechciUbytovani}">
    <label class="formular_polozka formular_polozka-checkbox">
        <input type="checkbox" class="shopUbytovani_nechciCheckbox" name="{postnameNechciUbytovani}" {checkedNechciUbytovani}>
        nechci ubytování
    </label>
</div>
<!-- end:nechciUbytovani -->

<div class="shopUbytovani_upozorneni" data-minimalni-pocet-noci="{minimalniPocetNoci}" aria-live="polite"
     style="display: none"></div>

<div class="shopUbytovani_tabulka">

    <div class="shopUbytovani_prvniSloupec">
        <div class="shop_den shopUbytovani_den">&nbsp;</div>
        <!-- begin:typ -->

        <!-- begin:normal -->
        <div class="shop_popis shopUbytovani_radek">
            {typ}
            <div class="shop_popisCena">{cena}&thinsp;Kč&thinsp;/&thinsp;noc</div>
        </div>
        <!-- end:normal -->

        <!-- begin:hinted -->
        <div class="shop_popis shopUbytovani_radek gc_tooltip">
            {typ} <span class="shopUbytovani_i"></span>
            <div class="shop_popisCena">{cena}&thinsp;Kč&thinsp;/&thinsp;noc</div>
            <div class="tooltip_obsah">{hint}</div>
        </div>
        <!-- end:hinted -->

        <!-- end:typ -->
        <div class="shopUbytovani_zadne">
            <div class="shop_popis">Žádné</div>
        </div>
    </div>

    <!-- begin:den -->
    <div class="shopUbytovani_sloupec">
        <div class="shop_den shopUbytovani_den">{den}</div>
        <!-- begin:typ -->
        <div class="shopUbytovani_radek">
                 <input type="radio" class="shopUbytovani_radio" name="{postnameDen}" value="{idPredmetu}"
                     data-kapacita="{kapacitaProJs}" data-typ="{typ}" data-podtyp="{podtyp}"
                     data-snidane-dny="{snidaneDnyProJs}" data-jen-s-kodem-skupiny="{jenSKodemSkupiny}"
                     data-malo-na-pokoj="{maloNaPokoj}" {checked} {disabled}>
            <div class="shopUbytovani_kapacita">{obsazeno}/{kapacita}</div>
        </div>
        <!-- end:typ -->
        <div class="shopUbytovani_zadne">
                 <input type="radio" class="shopUbytovani_radio" name="{postnameDen}" value="" data-kapacita="0"
                     data-typ="Žádné" data-snidane-dny="{snidaneDnyProJs}" {checked} {disabled}>
        </div>
    </div>
    <!-- end:den -->

<div style="clear: both"></div>

</div>

<div class="shopUbytovani_spolubydlici">
    <!-- begin:skupina -->
    <div class="shopUbytovani_skupina">
        <div class="shopUbytovani_skupinaNadpis">Spolubydlící</div>

        <!-- begin:clen -->
        <!-- begin:pozvanka -->
        <p>
            Na pokoji chceš bydlet se skupinou s kódem
            <strong class="shopUbytovani_kodSkupiny">{kodSkupiny}</strong>.
            Kód pošli těm, kdo mají bydlet s tebou, ať se ke skupině připojí.
        </p>
        <!-- end:pozvanka -->
        <!-- begin:uzavrena -->
        <p>
            Na pokoji budeš se skupinou spolubydlících
            <strong class="shopUbytovani_kodSkupiny">{kodSkupiny}</strong>:
        </p>
        <!-- end:uzavrena -->
        <ul class="shopUbytovani_clenoveSkupiny">
            <!-- begin:clenSkupiny -->
            <li>{jmenoClena} <span class="shopUbytovani_ubytovaniClena">({ubytovaniClena})</span></li>
            <!-- end:clenSkupiny -->
        </ul>
        <!-- begin:varovani -->
        <p class="shopUbytovani_varovaniSkupiny">{varovaniSkupiny}</p>
        <!-- end:varovani -->
        <!-- begin:opustit -->
        <label class="formular_polozka formular_polozka-checkbox">
            <input type="checkbox" name="{postnameOpustitSkupinu}" value="1">
            opustit skupinu
        </label>
        <!-- end:opustit -->
        <!-- end:clen -->

        <!-- begin:neclen -->
        <p>
            Chceš bydlet s kamarády? Jeden z vás založí skupinu a ostatním pošle její kód.
            Ve skupině musí mít všichni stejný typ ubytování a vejde se do ní tolik lidí, kolik má pokoj postelí.
            Na pokoje rozdělujeme podle skupin.
            Na hotelu zabere skupina celý pokoj hned při založení a zbylé postele drží pro ty, kdo se připojí.
        </p>
        <label class="formular_polozka formular_polozka-checkbox">
            <input type="checkbox" class="shopUbytovani_zalozitSkupinu" name="{postnameZalozitSkupinu}" value="1">
            založit novou skupinu
        </label>
        <!-- begin:zalozeniBezPokoje -->
        <p class="shopUbytovani_zalozeniBezPokoje" style="display: none">
            Na některé noci hotelu zbývá méně postelí, než má pokoj. Skupina na hotelu zabírá celý pokoj,
            takže s nimi založit nejde. Postel bez skupiny objednat můžeš.
        </p>
        <!-- end:zalozeniBezPokoje -->
        <label class="shopUbytovani_kodSkupinyVstup">
            nebo se připoj ke skupině s kódem
            <input type="text" class="formular_input" name="{postnameKodSkupiny}" value=""
                   placeholder="např. K7MPQX" autocomplete="off" maxlength="20">
        </label>
        <!-- begin:drzenePostele -->
        <p class="shopUbytovani_drzenePostele">
            Hotel je plný, ale skupiny na něm drží postele pro své spolubydlící.
            Když zadáš kód skupiny, půjde postel vybrat.
        </p>
        <!-- end:drzenePostele -->
        <label class="formular_polozka formular_polozka-checkbox">
            <input type="checkbox" name="{postnameSamotar}" value="1" {checkedSamotar}>
            nebo přijedu {sam}, spolubydlící mi přidělte
        </label>
        <p class="shopUbytovani_samotarPopis">
            Když to zaškrtneš, po konci prodeje ubytování tě doplníme na volnou postel k lidem stejného pohlaví.
        </p>
        <!-- end:neclen -->

        <!-- begin:zamceno -->
        <p>Zakládat skupiny spolubydlících a přidávat se do nich už nejde.</p>
        <!-- begin:samotar -->
        <p>Přijedeš {sam}, spolubydlící ti přidělíme.</p>
        <!-- end:samotar -->
        <!-- end:zamceno -->
    </div>
    <!-- end:skupina -->

    <label class="shopUbytovani_prani">
        Poznámka ke spolubydlícím:
        <input type="text" class="formular_input" name="{postnameSpolubydlici}" value="{spolubydlici}"
               placeholder="např. chceme být na buňce se skupinou K7MPQX">
    </label>
</div>

<!-- begin:ubytovaniPresKapacitu -->
    <div>
        <strong>Šéf Infopultu: </strong><input class="danger" type="button" value="přes kapacitu" onClick="presKapacitu()">
    </div>
<!-- end:ubytovaniPresKapacitu -->

<div class="shopUbytovani_povinne" style="display: none">
    {povinneUdaje}
</div>

<!-- shop-ubytovani.js -->
<script type="text/javascript" src="{shopUbytovaniJs}"></script>

<!-- end:ubytovani -->
