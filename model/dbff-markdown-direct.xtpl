<!-- begin:md -->

<style>
.dbffMdtext p { margin: 1.35em 0; }
.dbffMdtext > :first-child { margin-top: 0; }
/* náhled má na výšku jen pár řádků, velký obrázek se v něm ukáže zmenšený */
.dbffMdtext img { max-width: 100%; max-height: 6em; }
</style>

<!-- begin:popisek -->
<p class="dbffMdPopisek"><strong>{popisek}</strong></p>
<!-- end:popisek -->
<input type="hidden" name="{pnOldId}" value="{oldId}">
<table style="width:100%" class="editor-textu">
  <tr>
    <td style="width: 50%; vertical-align: top"><textarea style="width: 100%" rows="20" name="{pnText}" data-editor-textu{odUzivatele}>{text}</textarea></td>
    <td style="vertical-align: top" class="dbffMdtext" data-editor-textu-nahled>{mdText}</td>
  </tr>
</table>
<!-- editor nad polem (ui/src/editorTextu), bez skriptu zůstane obyčejné pole a náhled podle uloženého textu -->
<script type="module" src="{skriptEditoru}"></script>
<script>
  $('table.editor-textu').last().parent().css('padding', 0);
</script>
<!-- end:md -->
