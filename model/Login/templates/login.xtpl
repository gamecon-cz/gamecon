<!-- begin:login -->
<!DOCTYPE html>
<html lang="cs">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {headerPageInfo}

    <base href="{base}">

    <link rel="shortcut icon" href="files/favicon.png"/>

    <link rel="stylesheet" href="files/bootstrap.5.1.3.css"/>
    <link rel="stylesheet" href="files/design/font-awesome-6.1.1/css/all.min.css"/>
    <!-- begin:stylesheet -->
    <link rel="stylesheet" href="{url}?version={version}"/>
    <!-- end:stylesheet -->

    <script type="text/javascript" src="files/bootstrap.bundle.5.1.3.js"></script>
    <!-- begin:javascript -->
    <script type="text/javascript" src="{url}?version={version}"></script>
    <!-- end:javascript -->
</head>

<body>

<main class="main">

    <div class="container">
        <div class="d-flex justify-content-center align-items-center" style="min-height: 99vh">
            <img alt="GC logo" src="files/design/GC2022-logo-qHD.avif?version=c124a2fcc1327cef898d3e940bdd6bae"
                 class="background-image">

            <div>
            <!-- begin:hlaska -->
            <div class="form-text alert {tridaHlasky}" role="alert">{hlaska}</div>
            <!-- end:hlaska -->

            <!-- begin:formular -->
            <form method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="login" class="form-label">Jméno:</label>
                    <input class="form-control" type="text" name="{loginInputName}" id="login" autofocus required>
                    <div class="invalid-feedback">
                        Vyplň prosím přihlašovací jméno
                    </div>
                </div>

                <div class="mb-3">
                    <label for="heslo" class="form-label">Heslo:</label>
                    <input class="form-control" type="password" name="{passwordInputName}" id="heslo" required>
                    <div class="invalid-feedback">
                        Vyplň prosím heslo
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input class="form-check-input" type="checkbox" name="{trvaleInputName}" value="1" id="trvale"
                           aria-describedby="trvale-napoveda">
                    <label for="trvale" class="form-check-label">Trvale přihlásit</label>
                    <div class="form-text" id="trvale-napoveda">Na sdíleném počítači, třeba na infopultu, nezaškrtávej.</div>
                </div>

                <button type="submit" class="btn btn-primary">Přihlásit</button>
                <button type="submit" name="{qrInputName}" value="1" class="btn btn-outline-secondary ms-2"
                        formnovalidate>Přihlásit QR kódem</button>
            </form>
            <!-- end:formular -->

            <!-- begin:qr -->
            <div class="prihlaseniQr" data-prihlaseni-qr data-stav-url="{stavUrl}" data-po-prihlaseni="">
                <h1 class="h4 mb-3">Přihlášení QR kódem</h1>
                <img class="prihlaseniQr_kod mb-3" src="{qrKod}" alt="QR kód pro přihlášení" width="240" height="240">
                <ol class="prihlaseniQr_navod">
                    <li>Na telefonu, kde máš přihlášený účet na webu GameConu, naskenuj kód fotoaparátem,
                        nebo na webu v Nastavení tlačítkem <b>Načíst QR kód</b>.</li>
                    <li>Na telefonu vyber tohle číslo: <span class="prihlaseniQr_cislo">{cislo}</span></li>
                </ol>
                <p class="fw-bold" data-prihlaseni-qr-zprava aria-live="polite">Kód platí {platnostMinut} minuty.</p>
                <form method="post">
                    <!-- begin:trvale -->
                    <input type="hidden" name="{trvaleInputName}" value="1">
                    <!-- end:trvale -->
                    <button type="submit" name="{qrInputName}" value="1" class="btn btn-primary">Nový kód</button>
                    <button type="submit" name="{qrZrusitInputName}" value="1" class="btn btn-outline-secondary ms-2">
                        Přihlásit heslem
                    </button>
                </form>
            </div>
            <script src="{prihlaseniQrJs}"></script>
            <!-- end:qr -->
            </div>
        </div>

    </div>

    <!-- begin: ribbon -->
    <div class="corner-ribbon">{ribbonLabel}</div>
    <!-- end: ribbon -->

</main>

</body>
</html>

<!-- end:login -->
