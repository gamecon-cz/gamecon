# Preview-environment image for <slug>.preview.gamecon.cz.
#
# Unlike .docker/Dockerfile (whose dev image lives on Docker Hub as
# gameconcz/gamecon:8.3 and is bind-mounted by docker-compose in
# development), this image bakes the application source IN — no
# bind-mount, immutable per commit.
#
# Built by .github/workflows/deploy-preview.yml, tagged as
# ghcr.io/gamecon-cz/gamecon:preview-<slug>, pulled by the host's
# deploy-preview-branch.sh.
#
# Two stages: composer and yarn run on the dev image, and only the
# finished application is copied onto the runtime image, so Node, yarn,
# git and xdebug never reach the preview. The base images rebuild rarely
# (only when PHP extensions, system tools, or Node version change in
# .docker/Dockerfile).

ARG DEV_IMAGE=gameconcz/gamecon:8.3
ARG RUNTIME_IMAGE=gameconcz/gamecon:8.3-runtime

FROM ${DEV_IMAGE} AS application

USER root

# Bring the entire application source in. Layer ordering matters for
# cache hit rate: composer / yarn installs change less frequently than
# PHP files, so we copy them first. But the override file is heavy and
# the speed-up is small; for the MVP we just copy everything at once.
COPY --chown=www-data:www-data . /var/www/html/gamecon

WORKDIR /var/www/html/gamecon

# Composer + UI build. The repo commits `vendor/`, so `composer
# install --no-dev` mostly just regenerates the optimized autoloader
# (no network round-trips). UI build (`yarn build`) compiles the
# preact bundles into web/soubory/ui/ and admin/files/ui/.
# Runs as www-data so what it writes ends up owned by the runtime user,
# not root. node_modules is part of the tree that is copied to the
# runtime image below, so it has to go here.
USER www-data
RUN composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist \
    && cd ui && yarn install --frozen-lockfile && yarn build \
    && rm -rf node_modules

USER root

# Strip dev junk that snuck in via COPY .. The .git directory in
# particular is ~tens of MB and never read at runtime.
RUN rm -rf \
    /var/www/html/gamecon/.git \
    /var/www/html/gamecon/.github \
    /var/www/html/gamecon/.docker \
    /var/www/html/gamecon/tests \
    /var/www/html/gamecon/phpunit*.* \
    /var/www/html/gamecon/phpstan*.* \
    /var/www/html/gamecon/ecs.php

FROM ${RUNTIME_IMAGE}

USER root

COPY --from=application --chown=www-data:www-data /var/www/html/gamecon /var/www/html/gamecon

WORKDIR /var/www/html/gamecon

# Ensure cache/ and logy/ are writable by Apache. The dev image's
# .docker/init-container.sh handles UID matching for the bind-mount
# case; for the baked image we don't need that dance.
RUN mkdir -p \
    /var/www/html/gamecon/cache/private \
    /var/www/html/gamecon/cache/public \
    /var/www/html/gamecon/logy \
    && chown -R www-data:www-data \
        /var/www/html/gamecon/cache \
        /var/www/html/gamecon/logy

# Apache snippet that honors X-Forwarded-Proto from the Caddy reverse
# proxy. Without it, $_SERVER['HTTPS'] is unset in PHP and generated
# URLs (<base href>, redirects, cookies) come out as http://.
COPY preview/apache-https.conf /etc/apache2/conf-available/preview-https.conf
RUN a2enconf preview-https

# Defensive: the runtime image sets no ENV, but with ENV=local (the dev
# image) jsmeNaLocale() returns true and the app loads
# nastaveni-local-default.php — which hardcodes MIGRACE_HESLO='' regardless
# of getenv(). Previews need the env-driven nastaveni-preview.php path;
# any non-"local" value does that, "preview" is descriptive.
ENV ENV=preview

# Basic-auth credentials + gate-token signing secrets for the Caddy gate
# in front of preview / archive environments. The admin's dev rozcestník
# renders the gate login as copyable text and signs a ?gate= token onto
# the links (one-click access via the gate-validator). Baked in here so
# the preview UI behaves identically to ostra — same page, same links.
# Access-control secrets shared across all previews (not user data); GHCR
# repo is private and image layers are not publicly readable.
ARG PREVIEW_BASIC_AUTH_USER=""
ARG PREVIEW_BASIC_AUTH_PASSWORD=""
ARG ARCHIVE_BASIC_AUTH_USER=""
ARG ARCHIVE_BASIC_AUTH_PASSWORD=""
ARG PREVIEW_GATE_SECRET=""
ARG ARCHIVE_GATE_SECRET=""
ENV PREVIEW_BASIC_AUTH_USER=$PREVIEW_BASIC_AUTH_USER \
    PREVIEW_BASIC_AUTH_PASSWORD=$PREVIEW_BASIC_AUTH_PASSWORD \
    ARCHIVE_BASIC_AUTH_USER=$ARCHIVE_BASIC_AUTH_USER \
    ARCHIVE_BASIC_AUTH_PASSWORD=$ARCHIVE_BASIC_AUTH_PASSWORD \
    PREVIEW_GATE_SECRET=$PREVIEW_GATE_SECRET \
    ARCHIVE_GATE_SECRET=$ARCHIVE_GATE_SECRET

EXPOSE 80

# Standard Apache foreground (the dev image's gamecon-run.sh does the
# UID dance + cron setup, neither of which we need here). If we ever
# add per-preview cron, factor that in.
CMD ["apache2-foreground"]
