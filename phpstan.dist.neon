includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/shipmonk/dead-code-detector/rules.neon

parameters:
    level: 6
    paths:
        - symfony/config/
        - symfony/src/

    bootstrapFiles:
        - nastaveni/zavadec-zaklad.php

    ignoreErrors:
        # Structure/ is generated by app:dump-entity-sql-structure and
        # app:dump-entity-property-structure: one constant per column, whether or not
        # anything reads it. Mirroring the whole schema is the point, so "unused
        # constant" there says the generator worked, not that something is wrong.
        -
            identifier: shipmonk.deadConstant
            path: symfony/src/Structure/*

        # Response DTO properties are declared as API Platform `output:` and read by the
        # serializer through reflection, never by PHP code. The detector cannot see that,
        # so every field of every response looks unread — and deleting one would drop a
        # field from the API.
        #
        # Only *OutputDto: an input DTO is read by ordinary PHP in its processor, so the
        # detector sees those reads and an unread input field is a genuine finding.
        -
            identifier: shipmonk.deadProperty.neverRead
            path: symfony/src/Dto/*/*OutputDto.php

        # Entity accessors are written as a complete set when the entity is mapped, before
        # anything reads them, and Doctrine itself hydrates through the property, not the
        # getter. Reporting them would mean ~700 findings that say "this column has no
        # caller yet" — true, but not a defect, and it would fire again on every new
        # entity.
        #
        # is*/has* stay checked on purpose. They read like accessors but are usually
        # domain rules with real branching (Product::hasTag walks the tag collection,
        # ProductBundle::isMandatoryForUser weighs role meanings), and an orphaned
        # business rule is exactly what this tool is for.
        -
            identifier: shipmonk.deadMethod
            path: symfony/src/Entity/*
            message: '#::(get|set|add|remove)[A-Z]#'

        # Analysis covers only symfony/, so a constructor called from the legacy tree has no
        # visible caller: Cenik.php builds all three Discount classes, and the entities are
        # instantiated from model/, tests/ and symfony/tests/. Entities are also excluded
        # from DI in services.yaml, so the container cannot vouch for them either.
        #
        # Temporary: drop it once model/ is in paths:, which removes the cause rather than
        # the symptom. See docs/generated/phpstan-scope-legacy-tree.md.
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused App\\(Discount\\(DiscountCalculation|DiscountRuleLoader|DiscountableItem)|Entity\\(Activity|CategoryTag|ProductBundle|ProductDiscount|ProductVariant|Tournament|User))\:\:__construct$#'
            paths:
                - symfony/src/Entity/*
                - symfony/src/Discount/*

        # These five actions are routed from symfony/config/routes.yaml rather than by
        # #[Route], and the detector reads DI service definitions, not routing, so they
        # have no visible caller. Listed by name on purpose: a blanket Controller/* rule
        # would also silence the #[Route] actions, which the detector resolves by itself,
        # and every controller method added later.
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused App\\Controller\\(AdminController\:\:(dashboard|users|activities)|ApiController\:\:handle|TestController\:\:index)$#'
            path: symfony/src/Controller/*

    shipmonkDeadCode:
        usageProviders:
            symfony:
                # Autodetection reads a parameter that only phpstan-symfony defines, and this
                # project does not have that extension, so without these two the detector sees
                # no dependency injection at all and every controller, subscriber and
                # DI-only service reports as dead.
                enabled: true
                configDir: symfony/config
                containerXmlPaths:
                    - symfony/var/cache/dev/App_KernelDevDebugContainer.xml
