Allow from all

<IfModule mod_headers.c>
    # CORS — admin je na jiném jménu než web a čte odsud JSON programu. Přesměrování z cache.* sem (ansible, role caddy)
    # navíc posílá druhý požadavek s Origin: null, takže hlavička s jedním konkrétním původem nestačí
    Header always set Access-Control-Allow-Origin "*"
</IfModule>

# Zruší RewriteRule z kořenového .htaccess (.* → web/$0). Bez toho by se soubory odsud předávaly do PHP
# a přestaly by fungovat css, js a obrázky webu i adminu
RewriteEngine On

<IfModule mod_mime.c>
    AddType application/json .json
</IfModule>

<IfModule mod_expires.c>
    # cache 1 rok — hashovaná jména souborů (aktivity-2026-<hash>.json apod.) jsou content-addressed
    ExpiresActive On
    ExpiresDefault A31557600
</IfModule>

# Manifest nesmí být cachovaný — obsahuje aktuální hashe, na kterých závisí všechny ostatní soubory
<FilesMatch "^manifest-\d+\.json$">
    <IfModule mod_headers.c>
        Header always set Cache-Control "no-store, max-age=0"
        Header unset Expires
        Header unset ETag
    </IfModule>
    FileETag None
</FilesMatch>
