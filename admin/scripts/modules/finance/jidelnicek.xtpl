<!-- begin:jidelnicek -->
<div class="aBox" style="width:100%; overflow: auto;">
  <h3>Jídelníček {rocnik}</h3>

  <p>
    Ke každému obědu a večeři zadej jídla, ze kterých si účastníci vyberou. Kdo si nevybere,
    dostane výchozí jídlo. Počty jídel pro jídelnu jsou v Reportech (<i>Jídlo: počty konkrétních jídel</i>).
  </p>

  <link rel="stylesheet" href="files/ui/style.css?version={$cssVersions.style}">

  <div id="preact-jidelnicek-admin">Jídelníček se načítá…</div>

  <script>
    window.GAMECON_KONSTANTY = {
      ROCNIK: "{rocnik}",
      {jwtKonstanty}
    }
  </script>

  <script type="module" src="files/ui/bundle.js?version={jsVersions.bundle}"></script>
</div>
<!-- end:jidelnicek -->
