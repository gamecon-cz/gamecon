<!-- begin:medailonky -->

<h1>Medailonky</h1>

<form method="post">
  Vytvořit nový medailonek pro uživatele ID <input type="text" name="noveId"> <input type="submit" value="vytvořit">
</form>

<p>Horní část medailonku je obecná. Dolní část medailonku je pro DrD.</p>

<table class="vypis">
  <tr>
    <th>ID uživatele</th>
    <th>Uživatel</th>
    <th>Popis</th>
    <th>DrD</th>
    <th>Fotka</th>
    <th>Upravit</th>
  </tr>
  <!-- begin:radek -->
  <tr>
    <td>{uzivatelId}</td>
    <td>{jmenoNick}</td>
    <td style="text-align: center">
      <div class="hinted">{maPopisOSobe}
        <div class="hint">{oSobe}</div>
      </div>
    </td>
    <td style="text-align: center">
      <div class="hinted">{maDrdPopis}
        <div class="hint">{drdPopis}</div>
      </div>
    </td>
    <td style="text-align: center">{maFotku}</td>
    <td style="text-align: center">
      <a href="aktivity/medailonky?id={medailonek.id}" class="tlacitko"
         style="display: inline">
        <i class="fa fa-pencil-square-o" aria-hidden="true" style="padding: 0.2em"></i>
      </a>
    </td>
  </tr>
  <!-- end:radek -->
</table>

<!-- end:medailonky -->

<!-- begin:medailonek -->

<p><a href="aktivity/medailonky">← všechny medailonky</a></p>

<h1>Medailonek: {jmeno}</h1>

<p>Na webu ho najdeš na stránce vypravěče <a href="{urlNaWebu}" target="_blank" rel="noopener">{urlNaWebu}</a>.</p>

<h2>Fotka</h2>
{fotkaHtml}

<h2>Text</h2>
<!-- begin:formular -->
{formular}
<!-- end:formular -->
<!-- begin:zalozit -->
<p>Uživatel zatím nemá medailonek.</p>
<form method="post">
  <input type="hidden" name="noveId" value="{idUzivatele}">
  <input type="submit" value="Založit medailonek">
</form>
<!-- end:zalozit -->

<!-- end:medailonek -->
