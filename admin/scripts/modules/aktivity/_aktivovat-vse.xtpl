<!-- begin:aktivovatVse -->
<form class="submenuAktivovatVse" method="post">
  <span class="hinted">
    <button class="tlacitko tlacitko_isDanger" type="submit" name="aktivovatVse" value="1" {aktivovatVseDisabled}
            onclick="return window.confirm('Toto aktivuje všechny aktivity označené jako „připravené“ ve všech kategoriích. Určitě?');"><i class="fa-solid fa-bolt" aria-hidden="true"></i>aktivovat hromadně</button>
    <span class="hint" style="left: -5em">
      Hromadně aktivovat může pouze člen rady<br>
        a pouze všechny aktivity bez vybrané <i>Programové linie</i>.
    </span>
  </span>
</form>
<!-- end:aktivovatVse -->
