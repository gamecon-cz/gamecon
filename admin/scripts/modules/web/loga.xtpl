<!-- begin:loga -->

<p class="tip">
  <i class="fa fa-arrows" aria-hidden="true"></i>
  Pořadí log změníš přetažením loga na jiné místo, uloží se hned. Nově nahraná loga se přidají na konec.
</p>

<h2>Titulní strana</h2>

<!-- begin:sponzoriTitulka -->
<h3>Loga sponzorů na titulce</h3>
<p>Zobrazují se na <a href="{urlSponzoriTitulka}" target="_blank">titulní straně webu</a>.</p>
<div class="logos-container" data-typ="sponzor_titulka">
  <!-- begin:logo -->
  <div class="logo-item" data-soubor="{filename}">
    <i class="fa fa-arrows logo-uchyt" aria-hidden="true" title="Přetažením změníš pořadí"></i>
    <img src="{src}" alt="{nazev}" style="max-width: 120px; max-height: 60px;">
    <p><strong>{nazev}</strong></p>
    <p><a href="{url}" target="_blank">{url}</a></p>
    <div class="logo-actions">
      <form method="post" style="display: inline;">
        <input type="hidden" name="action" value="remove_sponzor_titulka">
        <input type="hidden" name="filename" value="{filename}">
        <button type="submit" class="btn-remove" onclick="return confirm('Opravdu chcete smazat logo {nazev}?')">
          Smazat
        </button>
      </form>
    </div>
  </div>
  <!-- end:logo -->
</div>
<div class="logo-poradi-stav" role="status"></div>
<form method="post" enctype="multipart/form-data" class="logo-upload">
  <input type="file" name="logo_file" required>
  <label>URL sponzora <input type="text" name="url" placeholder="https://"
                             pattern="^(https?:\/\/)?([a-zA-Z0-9\-]+\.)+[a-zA-Z]{2,}.*$" required></label> <input
    type="hidden" name="action" value="upload_sponzor_titulka">
  <button type="submit">Nahrát logo sponzora</button>
</form>
<hr>
<!-- end:sponzoriTitulka -->

<!-- begin:partneriTitulka -->
<h3>Loga partnerů na titulce</h3>
<p>Zobrazují se na <a href="{urlPartneriTitulka}" target="_blank">titulní straně webu</a>.</p>
<div class="logos-container" data-typ="partner_titulka">
  <!-- begin:logo -->
  <div class="logo-item" data-soubor="{filename}">
    <i class="fa fa-arrows logo-uchyt" aria-hidden="true" title="Přetažením změníš pořadí"></i>
    <img src="{src}" alt="{nazev}" style="max-width: 120px; max-height: 60px;">
    <p><strong>{nazev}</strong></p>
    <p><a href="{url}" target="_blank">{url}</a></p>
    <div class="logo-actions">
      <form method="post" style="display: inline;">
        <input type="hidden" name="action" value="remove_partner_titulka">
        <input type="hidden" name="filename" value="{filename}">
        <button type="submit" class="btn-remove" onclick="return confirm('Opravdu chcete smazat logo {nazev}?')">
          Smazat
        </button>
      </form>
    </div>
  </div>
  <!-- end:logo -->
</div>
<div class="logo-poradi-stav" role="status"></div>
<form method="post" enctype="multipart/form-data" class="logo-upload">
  <input type="file" name="logo_file" required>
  <label>URL partnera <input type="url" name="url" placeholder="https://" required></label>
  <input type="hidden" name="action" value="upload_partner_titulka">
  <button type="submit">Nahrát logo partnera</button>
</form>
<hr>
<!-- end:partneriTitulka -->

<!-- begin:sponzoriPrehled -->
<h2>Loga sponzorů v přehledu</h2>
<p>Zobrazují se na <a href="{urlSponzoriPrehled}" target="_blank">stránce Sponzoři</a>.</p>
<div class="logos-container" data-typ="sponzor_prehled">
  <!-- begin:logo -->
  <div class="logo-item" data-soubor="{filename}">
    <i class="fa fa-arrows logo-uchyt" aria-hidden="true" title="Přetažením změníš pořadí"></i>
    <img src="{src}" alt="{nazev}" style="max-width: 120px; max-height: 60px;">
    <p><strong>{nazev}</strong></p>
    <p><a href="{url}" target="_blank">{url}</a></p>
    <div class="logo-actions">
      <form method="post" style="display: inline;">
        <input type="hidden" name="action" value="remove_sponzor_prehled">
        <input type="hidden" name="filename" value="{filename}">
        <button type="submit" class="btn-remove" onclick="return confirm('Opravdu chcete smazat logo {nazev}?')">
          Smazat
        </button>
      </form>
    </div>
  </div>
  <!-- end:logo -->
</div>
<div class="logo-poradi-stav" role="status"></div>
<form method="post" enctype="multipart/form-data" class="logo-upload">
  <input type="file" name="logo_file" required>
  <label>URL sponzora <input type="url" name="url" placeholder="https://" required></label>
  <input type="hidden" name="action" value="upload_sponzor_prehled">
  <button type="submit">Nahrát logo sponzora</button>
</form>
<hr>
<!-- end:sponzoriPrehled -->

<!-- begin:partneriPrehled -->
<h2>Loga partnerů v přehledu</h2>
<p>Zobrazují se na <a href="{urlPartneriPrehled}" target="_blank">stránce Sponzoři</a>.</p>
<div class="logos-container" data-typ="partner_prehled">
  <!-- begin:logo -->
  <div class="logo-item" data-soubor="{filename}">
    <i class="fa fa-arrows logo-uchyt" aria-hidden="true" title="Přetažením změníš pořadí"></i>
    <img src="{src}" alt="{nazev}" style="max-width: 120px; max-height: 60px;">
    <p><strong>{nazev}</strong></p>
    <p><a href="{url}" target="_blank">{url}</a></p>
    <div class="logo-actions">
      <form method="post" style="display: inline;">
        <input type="hidden" name="action" value="remove_partner_prehled">
        <input type="hidden" name="filename" value="{filename}">
        <button type="submit" class="btn-remove" onclick="return confirm('Opravdu chcete smazat logo {nazev}?')">
          Smazat
        </button>
      </form>
    </div>
  </div>
  <!-- end:logo -->
</div>
<div class="logo-poradi-stav" role="status"></div>
<form method="post" enctype="multipart/form-data" class="logo-upload">
  <input type="file" name="logo_file" required>
  <label>URL partnera <input type="url" name="url" placeholder="https://" required></label>
  <input type="hidden" name="action" value="upload_partner_prehled">
  <button type="submit">Nahrát logo partnera</button>
</form>
<hr>
<!-- end:partneriPrehled -->


<script>
    $(function () {
        $('.logos-container[data-typ]').each(function () {
            var $seznam = $(this);
            var $stav = $seznam.next('.logo-poradi-stav');

            var poradi = function () {
                return $seznam.children('.logo-item').map(function () {
                    return $(this).attr('data-soubor');
                }).get();
            };
            var naposledyUlozenePoradi = poradi();
            var zobrazStav = function (text, jeChyba) {
                $stav.text(text).toggleClass('logo-poradi-stav--chyba', jeChyba);
            };
            var vratNaposledyUlozenePoradi = function () {
                $.each(naposledyUlozenePoradi, function (index, soubor) {
                    $seznam.append($seznam.children('.logo-item').filter(function () {
                        return $(this).attr('data-soubor') === soubor;
                    }));
                });
            };

            $seznam.sortable({
                items: '> .logo-item',
                cancel: 'a, button, input',
                tolerance: 'pointer',
                distance: 5,
                opacity: 0.85,
                placeholder: 'logo-placeholder',
                forcePlaceholderSize: true,
                start: function () {
                    zobrazStav('', false);
                },
                update: function () {
                    var novePoradi = poradi();
                    $seznam.sortable('disable');
                    $.post(window.location.href, {action: 'save_razeni', typ: $seznam.attr('data-typ'), poradi: novePoradi}, null, 'json')
                        .done(function () {
                            naposledyUlozenePoradi = novePoradi;
                            zobrazStav('Pořadí uloženo.', false);
                        })
                        .fail(function (odpoved) {
                            vratNaposledyUlozenePoradi();
                            var chyba = odpoved.responseJSON && odpoved.responseJSON.error
                                ? odpoved.responseJSON.error
                                : 'Nepodařilo se navázat spojení.';
                            zobrazStav('Pořadí se nepodařilo uložit, vrátilo se původní. ' + chyba, true);
                        })
                        .always(function () {
                            $seznam.sortable('enable');
                        });
                }
            });
        });
    });
</script>

<style>
    .logos-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin: 20px 0 0;
        background-color: rgba(215, 246, 170, 0.24);
    }

    .logo-item {
        position: relative;
        border: 1px solid #ddd;
        padding: 10px;
        border-radius: 5px;
        text-align: center;
        min-width: 150px;
        cursor: grab;
    }

    .logo-uchyt {
        position: absolute;
        top: 6px;
        left: 8px;
        color: #999;
    }

    .logo-item:hover .logo-uchyt {
        color: #333;
    }

    .logo-item.ui-sortable-helper {
        background-color: #fff;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);
        cursor: grabbing;
    }

    .logo-placeholder {
        border: 2px dashed #999;
        border-radius: 5px;
        box-sizing: border-box;
    }

    .logo-poradi-stav {
        min-height: 1.5em;
        margin-bottom: 0.5em;
        color: #1a7f37;
    }

    .logo-poradi-stav--chyba {
        color: #c00;
    }

    .logo-item img {
        display: block;
        margin: 0 auto 10px;
    }

    .logo-item p {
        margin: 5px 0;
        font-size: 12px;
    }

    .logo-actions {
        margin-top: 10px;
    }

    .logo-upload {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5em 1em;
        padding: 0.5em 1em;
        background-color: rgba(215, 246, 170, 0.47);
    }

    .logo-upload label {
        display: flex;
        flex: 1 1 20em;
        align-items: center;
        gap: 0.5em;
    }

    .logo-upload label input {
        flex: 1;
        min-width: 0;
    }

    .btn-remove {
        padding: 5px 10px;
        margin: 2px;
        border: 1px solid #ddd;
        border-radius: 3px;
        cursor: pointer;
        font-size: 12px;
        background: #dc3545;
        color: white;
    }

    .btn-remove:hover {
        background: #c82333;
    }
</style>


<!-- end:loga -->
