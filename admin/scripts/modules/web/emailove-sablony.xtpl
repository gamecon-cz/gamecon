<!-- begin: seznam -->

<h1>Texty e-mailů</h1>

{problemy}

<p>
    Předmět a text každého e-mailu, který GameCon posílá. Změna platí hned, bez nasazení.
    Texty smí upravovat každý, kdo smí upravovat stránky webu.
</p>

<style>
    .emailoveSablony td {
        vertical-align: top;
    }

    .emailoveSablony td.hinted {
        border-bottom: none;
    }
</style>

<table class="zvyraznovana emailoveSablony" style="width: 100%">
    <colgroup>
        <col style="width: 20%">
        <col style="width: 31%">
        <col style="width: 14%">
        <col style="width: 19%">
        <col style="width: 3%">
        <col style="width: 13%">
    </colgroup>
    <!-- begin: skupina -->
    <thead>
    <tr>
        <th colspan="6"><h2>{skupina}</h2></th>
    </tr>
    <tr>
        <th>E-mail</th>
        <th>Kdy odchází</th>
        <th>Komu</th>
        <th>Předmět</th>
        <th></th>
        <th>{nazevSloupcePosledniZmena}</th>
    </tr>
    </thead>
    <tbody>
    <!-- begin: sablona -->
    <tr id="{kod}">
        <td>{problem}<a href="{odkaz}">{nazev}</a></td>
        <td>{kdyOdchazi}</td>
        <td>{prijemce}</td>
        <td>{predmet}</td>
        <td><a href="{urlModulu}#{kod}" class="lokalni-odkaz float-right">#</a></td>
        <td class="{zmenenoTrida}">{zmenenoObsah}</td>
    </tr>
    <!-- end: sablona -->
    </tbody>
    <!-- end: skupina -->
</table>

<!-- end: seznam -->
