<!-- begin: hlavickyLinii -->

<style>
  .hlavicky-linii {
    width: 100%;
    border-collapse: collapse;
  }

  .hlavicky-linii th,
  .hlavicky-linii td {
    padding: 12px;
    border-bottom: 1px solid #ddd;
    vertical-align: top;
  }

  .hlavicky-linii th:first-child {
    width: 22em;
  }

  .hlavicky-linii input[type="text"],
  .hlavicky-linii input[type="email"] {
    width: 100%;
    box-sizing: border-box;
  }

  .hlavicky-linii__meta {
    color: #555;
    font-size: 0.9em;
  }

  .hlavicky-linii__texty {
    display: block;
    margin-top: 1.2em;
    padding-top: 1em;
    border-top: 1px solid #ddd;
  }

  .hlavicky-linii__texty label {
    display: block;
    margin-bottom: 0.8em;
  }

  .hlavicky-linii__nahled-a-zapisy {
    display: flex;
    gap: 1em;
    align-items: flex-start;
    margin-bottom: 1em;
  }

  .hlavicky-linii__preview {
    display: block;
    width: 160px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #f3f3f3;
  }

  .hlavicky-linii__zapisy {
    margin-bottom: 0.6em;
  }

  .hlavicky-linii__zapisy label {
    display: grid;
    grid-template-columns: 6em minmax(0, 40em);
    align-items: center;
    margin: 0.2em 0;
  }

  .hlavicky-linii__akce {
    display: flex;
    gap: 8px 16px;
    flex-wrap: wrap;
    align-items: center;
  }

  .hlavicky-linii__nahrat {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
</style>

<p>
  Tady se upravuje text a obrázek v hlavičce programové linie na webu aktivit.
  Když necháš všechna textová pole prázdná, použije se fallback. Obrázek se ukládá jako
  <code>org_&lt;id_typu&gt;.&lt;pripona&gt;</code>, kde podporujeme JPG, PNG, WebP a GIF. JPG a PNG bez animace se při nahrání převedou na WebP.
  Pokud nový obrázek chybí, web ještě vezme starší <code>&lt;id_typu&gt;.png</code>, pokud existuje.
</p>

<table class="hlavicky-linii">
  <thead>
  <tr>
    <th>Linie a texty</th>
    <th>Obrázek</th>
  </tr>
  </thead>
  <tbody>
  <!-- begin: radek -->
  <tr>
    <td>
      <strong>{typ_1pmn}</strong><br>
      <span class="hlavicky-linii__meta">ID {id_typu}, URL <code>{url_typu_mn}</code></span><br>
      <a href="{verejna_url_linie}" target="_blank">otevřít veřejnou stránku</a>

      <form method="post" class="hlavicky-linii__texty">
        <input type="hidden" name="action" value="save-line-header">
        <input type="hidden" name="id_typu" value="{id_typu}">

        <label>
          Sekce<br>
          <input type="text" name="sekce" value="{sekce}">
        </label>

        <label>
          Jméno<br>
          <input type="text" name="jmeno" value="{jmeno}">
        </label>

        <label>
          E-mail<br>
          <input type="email" name="email" value="{email}">
        </label>

        <button type="submit"><i class="fa fa-save" aria-hidden="true"></i> Uložit texty</button>
      </form>
    </td>
    <td>
      <div class="hlavicky-linii__nahled-a-zapisy">
        <a href="{obrazek_url}" target="_blank" rel="noopener" title="Zobrazit obrázek v původní velikosti">
          <img class="hlavicky-linii__preview" src="{obrazek_nahled}" alt="Náhled obrázku linie {typ_1pmn}">
        </a>
        <div>
          <!-- begin: zapisy -->
          <div class="hlavicky-linii__zapisy">
            <label>Markdown: <input type="text" readonly value="{zapis_markdown}" size="60"></label>
            <label>HTML: <input type="text" readonly value="{zapis_html}" size="60"></label>
          </div>
          <!-- end: zapisy -->
          <div class="hlavicky-linii__meta">
            <!-- begin: cesta -->
            Cesta: <code>{obrazek_cesta}</code><br>
            <!-- end: cesta -->
            <!-- begin: stav -->
            {obrazek_stav}
            <!-- end: stav -->
          </div>
        </div>
      </div>

      <div class="hlavicky-linii__akce">
        <form method="post" enctype="multipart/form-data" class="hlavicky-linii__nahrat">
          <input type="hidden" name="action" value="upload-line-header-image">
          <input type="hidden" name="id_typu" value="{id_typu}">
          <input type="file" name="obrazek" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" required>
          <button type="submit"><i class="fa fa-upload" aria-hidden="true"></i> Nahrát obrázek</button>
        </form>

        <!-- begin: smazat -->
        <form method="post" onsubmit="return confirm('Opravdu smazat vlastní obrázek linie?')">
          <input type="hidden" name="action" value="delete-line-header-image">
          <input type="hidden" name="id_typu" value="{id_typu}">
          <button type="submit"><i class="fa fa-trash" aria-hidden="true"></i> Smazat vlastní obrázek</button>
        </form>
        <!-- end: smazat -->
      </div>
    </td>
  </tr>
  <!-- end: radek -->
  </tbody>
</table>

<!-- end: hlavickyLinii -->
