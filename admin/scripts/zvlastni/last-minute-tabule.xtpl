<!-- begin:tabule -->
<!DOCTYPE html>
<html lang="cs">
  <head>
    <title>Nejbližší volné aktivity</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="30">
    <link rel="preload" href="{urlWebu}/soubory/blackarrow/_spolecne/fonty/Gilroy-Medium.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{urlWebu}/soubory/blackarrow/_spolecne/fonty/Gilroy-Bold.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{urlWebu}/soubory/blackarrow/_spolecne/fonty/Gilroy-Extrabold.woff2" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face {
        font-family: 'Gilroy';
        src:
          url('{urlWebu}/soubory/blackarrow/_spolecne/fonty/Gilroy-Medium.woff2') format('woff2'),
          url('{urlWebu}/soubory/blackarrow/_spolecne/fonty/Gilroy-Medium.woff') format('woff');
      }
      @font-face {
        font-family: 'Gilroy';
        font-weight: bold;
        src:
          url('{urlWebu}/soubory/blackarrow/_spolecne/fonty/Gilroy-Bold.woff2') format('woff2'),
          url('{urlWebu}/soubory/blackarrow/_spolecne/fonty/Gilroy-Bold.woff') format('woff');
      }
      @font-face {
        font-family: 'Gilroy';
        font-weight: 800;
        src:
          url('{urlWebu}/soubory/blackarrow/_spolecne/fonty/Gilroy-Extrabold.woff2') format('woff2'),
          url('{urlWebu}/soubory/blackarrow/_spolecne/fonty/Gilroy-Extrabold.woff') format('woff');
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 28px 24px 32px;
        font-family: Gilroy, 'Open Sans', tahoma, sans-serif;
        background-color: #F6F1EA;
        color: #10111A;
        min-height: 100vh;
      }

      .tabule {
        max-width: 1200px;
        margin: 0 auto;
      }

      .blok { margin: 0 auto 64px; }
      .blok:last-child { margin-bottom: 24px; }

      .blok__nadpis {
        margin: 0 0 26px;
        text-align: center;
        font-size: 46px;
        font-weight: 800;
        letter-spacing: -0.5px;
      }

      /* broskvový „tah štětcem" za nadpisem, jako čmáranice na webu GC */
      .blok__nadpis span {
        position: relative;
        display: inline-block;
        padding: 8px 30px 10px;
      }
      .blok__nadpis span::before {
        content: '';
        position: absolute;
        inset: 16% -8px 6% -14px;
        background: #FDC689;
        border-radius: 58% 42% 60% 40% / 55% 65% 35% 45%;
        transform: rotate(-1.3deg);
        z-index: -1;
      }

      .blok__seznam {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 12px 34px rgba(16, 17, 26, 0.09);
        overflow: hidden;
      }

      .aktivita {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 17px 32px;
        font-size: 28px;
        border-top: 1px solid rgba(16, 17, 26, 0.07);
      }
      .aktivita:first-child { border-top: 0; }

      .aktivita__zacatek {
        min-width: 3em;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        color: #E22630;
      }

      .aktivita__nazev {
        flex: 1;
        font-weight: bold;
        text-align: left;
      }

      .aktivita__obsazenost {
        display: flex;
        align-items: center;
        gap: 14px;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        color: rgba(16, 17, 26, 0.55);
      }
      .aktivita--skoroPlno .aktivita__obsazenost { color: #E22630; font-weight: bold; }

      .aktivita__obsazenost .f { color: #D6408B; }
      .aktivita__obsazenost .m { color: #0A7CD8; }
      /* pohlaví, na které se už nedá přihlásit, ať netahá oko barvou */
      .aktivita__obsazenost--jenZeny .m,
      .aktivita__obsazenost--jenMuzi .f { color: rgba(16, 17, 26, 0.35); }
      .aktivita__obsazenost .f::before { content: '♀ '; }
      .aktivita__obsazenost .m::before { content: '♂ '; }

      .stitek {
        background: #E22630;
        color: #fff;
        font-size: 17px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 6px 14px 5px;
        border-radius: 999px;
      }

      .aktivita--nic {
        justify-content: center;
        color: rgba(16, 17, 26, 0.55);
        padding: 34px;
      }

      .paticka {
        margin-top: 48px;
        text-align: center;
        font-size: 16px;
        color: rgba(16, 17, 26, 0.4);
      }

      .lupa {
        position: fixed;
        top: 20px;
        left: 20px;
        display: flex;
        flex-direction: row;
        gap: 10px;
        opacity: 0.25;
      }
      .lupa:hover { opacity: 1; }
      .lupa button[hidden] { display: none; }
      .lupa button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: 2px solid rgba(16, 17, 26, 0.4);
        border-radius: 50%;
        background: none;
        cursor: pointer;
        padding: 0;
        /* Ikony jsou kreslené jako SVG, ne písmena: znaky +, − a × sedí v každém
           fontu jinak vysoko nad účařím, takže se do kolečka nikdy netrefí přesně
           na střed. Geometrie SVG je symetrická z definice. */
        color: rgba(16, 17, 26, 0.6);
      }
      .lupa button svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
        stroke-width: 2.5;
        stroke-linecap: round;
      }
      .lupa button:hover {
        border-color: #E22630;
        color: #E22630;
      }
    </style>
    <script>
      (function () {
        const VYCHOZI_ZOOM = 100;
        const KROK_ZOOMU = 10;
        const NEJMENSI_ZOOM = 30;
        const NEJVETSI_ZOOM = 300;

        const zUrl = Number(new URLSearchParams(location.search).get('zoom'));
        let zoom = Number.isFinite(zUrl) && zUrl > 0 ? zUrl : VYCHOZI_ZOOM;

        // Zvětšení zapiš jako CSS pravidlo hned tady v <head>, tedy dřív, než se
        // tabule poprvé vykreslí — jinak by při obnovení stránky problikla ve
        // výchozí velikosti a teprve pak doskočila na zvolenou.
        const pravidlo = document.head.appendChild(document.createElement('style'));

        function zobrazZoom() {
          zoom = Math.min(NEJVETSI_ZOOM, Math.max(NEJMENSI_ZOOM, zoom));
          pravidlo.textContent = '.tabule { zoom: ' + zoom + '%; }';

          // při prvním běhu (v <head>) tlačítko ještě neexistuje, dorovná se níž
          const tlacitkoResetu = document.querySelector('[data-zoom="reset"]');
          if (tlacitkoResetu) {
            tlacitkoResetu.hidden = zoom === VYCHOZI_ZOOM;
          }

          // zoom drž v URL, ať ho přežije automatické obnovení stránky
          const adresa = new URL(location.href);
          if (zoom === VYCHOZI_ZOOM) {
            adresa.searchParams.delete('zoom');
          } else {
            adresa.searchParams.set('zoom', String(zoom));
          }
          history.replaceState(null, '', adresa);
        }

        zobrazZoom();
        document.addEventListener('DOMContentLoaded', zobrazZoom);

        document.addEventListener('click', function (udalost) {
          const tlacitko = udalost.target.closest('[data-zoom]');
          if (!tlacitko) {
            return;
          }

          if (tlacitko.dataset.zoom === 'plus') {
            zoom += KROK_ZOOMU;
          } else if (tlacitko.dataset.zoom === 'minus') {
            zoom -= KROK_ZOOMU;
          } else {
            zoom = VYCHOZI_ZOOM;
          }
          zobrazZoom();
        });
      })();
    </script>
  </head>
  <body>

  <nav class="lupa">
    <button type="button" title="Zvětšit" data-zoom="plus">
      <svg viewBox="-10 -10 20 20" aria-hidden="true"><path d="M-7 0H7M0 -7V7"/></svg>
    </button>
    <button type="button" title="Zmenšit" data-zoom="minus">
      <svg viewBox="-10 -10 20 20" aria-hidden="true"><path d="M-7 0H7"/></svg>
    </button>
    <button type="button" title="Výchozí velikost" data-zoom="reset" hidden>
      <svg viewBox="-10 -10 20 20" aria-hidden="true"><path d="M-6 -6L6 6M6 -6L-6 6"/></svg>
    </button>
  </nav>

  <main class="tabule">
    <!-- begin:blok -->
    <section class="blok">
      <h2 class="blok__nadpis"><span>Volná místa {zitra} od {cas}</span></h2>
      <div class="blok__seznam">
        <!-- begin:aktivita -->
        <article class="aktivita {plnostTrida}">
          <span class="aktivita__zacatek">{zacatek}</span>
          <span class="aktivita__nazev">{nazev}</span>
          <span class="aktivita__obsazenost {obsazenoTrida}">{obsazenost}{stitek}</span>
        </article>
        <!-- end:aktivita -->
        <!-- begin:nic -->
        <div class="aktivita aktivita--nic">Právě teď není nikde volno — zkus to za chvíli.</div>
        <!-- end:nic -->
      </div>
    </section>
    <!-- end:blok -->
  </main>

  <footer class="paticka">Teď je {ted} &middot; tabule se sama obnovuje každou půlminutu</footer>

  </body>
</html>
<!-- end:tabule -->
