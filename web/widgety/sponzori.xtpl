<!-- begin: sponzori -->
<div class="widget-sponzori">
  <div class="sponzori_loga">
    <!-- begin: sponzor -->
    <div class="sponzori_logo">
      <a href="{url}" target="_blank"><img src="{src}" alt="{url}" loading="lazy"></a>
    </div>
    <!-- end:sponzor -->
  </div>
  <div class="partneri_loga">
    <!-- begin: partner -->
    <div class="partneri_logo">
      <a href="{url}" target="_blank"><img src="{src}" alt="{url}" loading="lazy"></a>
    </div>
    <!-- end:partner -->
  </div>
</div>
<!-- end: sponzori -->
