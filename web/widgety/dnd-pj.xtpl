<!-- begin: dndPj -->

<div class="medailonky">
  <!-- begin: pj -->
  <article class="medailonek">
    <img class="medailonek_fotka" src="{fotka}" alt="">
    <div class="medailonek_popis">
      <h3 class="medailonek_jmeno">{jmenoNaWebu}</h3>
      <p>Dungeon Master</p>
    </div>
    <!-- begin: oSobe -->
    <details class="medailonek_vice">
      <summary>O sobě píše</summary>
      <div class="medailonek_text">{oSobe}</div>
    </details>
    <!-- end: oSobe -->
  </article>
  <!-- end: pj -->
</div>

<!-- end: dndPj -->
