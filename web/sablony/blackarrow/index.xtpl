<!-- begin: index -->
<!DOCTYPE html>
<html lang="{jazyk}">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{t:web.popis}">
    <base href="{base}">
    {FILE "sablony/blackarrow/fonty.xtpl"}
    <link rel="stylesheet" href="../../soubory/blackarrow/_spolecne/details.css">
    <link rel="stylesheet" href="{css}">
    <!-- begin: extraCss --><link rel="stylesheet" href="{url}"><!-- end: extraCss -->
    <!-- begin: extraJs --><script src="{url}"></script><!-- end: extraJs -->
    {info}
    <link rel="icon" href="soubory/blackarrow/_spolecne/favicon.png">
</head>

{FILE "sablony/blackarrow/gtag.xtpl"}

<body>

    {menu}

    {chyba}

    {obsah}

    <!-- begin: paticka -->
    <div class="paticka">
        <div class="paticka_info">
            <a href="mailto:info@gamecon.cz">info@gamecon.cz</a>
            <div class="paticka_copy">&copy; {letosniRok} GameCon, Created by GameCon z.s.</div>
        </div>
        <div class="paticka_odkazy">
            <!-- begin: qrka -->
            <a href="qrka">{t:paticka.qr_k_sockam}</a>
            <!-- end: qrka -->
            <a href="sponzori">{t:paticka.sponzori}</a>
            <a href="kontakty">{t:paticka.kontakt}</a>
            <a href="drd">{t:paticka.archiv_mdrd}</a>
            <a href="discord" target="_blank" class="paticka_ext paticka_discord">Discord</a>
            <a href="instagram" target="_blank" class="paticka_ext paticka_instagram">Instagram</a>
            <a href="youtube" target="_blank" class="paticka_ext paticka_youtube">Youtube</a>
        </div>
    </div>
    <!-- end: paticka -->

    <!-- begin: ribbon -->
    <div class="corner-ribbon">{ribbonLabel}</div>
    <!-- end: ribbon -->
</body>
</html>
<!-- end: index -->
