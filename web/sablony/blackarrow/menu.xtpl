<!-- begin: menu -->

<!-- prázdný onclick je fix hoveru pro iphone -->
<div class="menu" onclick="">
  <div class="menu_obal">
    <div class="menu_obal2">

      <a href="." class="menu_nazev">GameCon</a>
      

      <div class="menu_uzivatel">
        <!-- begin: neprihlasen -->
        <a class="menu_prihlasit" href="prihlaseni">{t:menu.prihlasit}</a>
        <!-- end: neprihlasen -->
        <!-- begin: prihlasen -->
        <div class="menu_jmeno">{uJmenoMenu} ({u.id})</div>
        <div class="menu_uzivatelpolozky">
          <a href="finance">{t:menu.finance}</a>
          <a href="registrace">{t:menu.nastaveni}</a>
          <!-- begin: admin -->
          <a href="{uvodniAdminUrl}" target="_blank">{t:menu.admin}</a>
          <!-- end: admin -->
          <!-- begin: mujPrehled -->
          <a href="{mojeAktivityAdminUrl}" target="_blank">{t:menu.hry_ktere_vedu}</a>
          <!-- end: mujPrehled -->
          <a href="prihlaska">{gcPrihlaska}</a>
          <a href="#" onclick="odhlasForm.submit(); return false;">{t:menu.odhlasit}</a>
          <form id="odhlasForm" method="post" action="prihlaseni">
            <input type="hidden" name="odhlasit" value="true">
          </form>
        </div>
        <!-- end: prihlasen -->
      </div>

      <!-- begin: jazyk -->
      <a class="menu_jazyk" href="{jazykUrl}" title="{jazykTitulek}" lang="{jazykKod}" hreflang="{jazykKod}">{jazykNazev}</a>
      <!-- end: jazyk -->

      <div class="menu_menu">
        <a href="program" class="menu_odkaz">{t:menu.program}</a>
        <div class="menu_kategorie">
          <div class="menu_nazevkategorie">{t:menu.aktivity}</div>
          <div class="menu_polozky">
            <!-- begin: typAktivit -->
            <a href="{typ.url}" class="menu_polozka">{typ.nazev}</a>
            <!-- end: typAktivit -->
          </div>
        </div>
        <div class="menu_kategorie">
          <div class="menu_nazevkategorie">{t:menu.informace}</div>
          <div class="menu_polozky">
            <a class="menu_polozka" href="prakticke-informace">{t:menu.prakticke_informace}</a>
            <a class="menu_polozka" href="jidelnicek">{t:menu.jidelnicek}</a>
            <a class="menu_polozka" href="organizacni-vypomoc">{t:menu.chci_organizovat}</a>
            <a class="menu_polozka" href="blog">{t:menu.blog}</a>
            <a class="menu_polozka" href="pro-sponzory-a-media">{t:menu.pro_sponzory_a_media}</a>
            <a class="menu_polozka" href="kontakty">{t:menu.kontakty}</a>

          </div>
        </div>
        <a href="prihlaska" class="menu_odkaz menu_pryc">{gcPrihlaska}</a>
      </div>

    </div>
  </div>
</div>

<!-- end: menu -->
