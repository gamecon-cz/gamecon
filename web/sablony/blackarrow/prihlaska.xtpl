<!-- begin:prihlaska -->

<div class="prihlaska_hlavickaObal">
    <div class="prihlaska_hlavicka">
        <h1>{t:prihlaska.nadpis}</h1>

        <!-- begin:prihlasen -->
        <p>{aktivni}</p>

        <div class="prihlaska_hlavickaFinance">
            <p>{uhraditDo} {prehledFinanci}</p>
        </div>

        <!-- begin:potvrzeniZakonnyZastupce -->
        <div class="prihlaska_potrebaPotvrzeni {uspesneNahrano}">
            <p>{souhlasRodicu}</p>

            <form method="post" enctype="multipart/form-data">
                <input type="file" class="formular_input" name="potvrzeniRodicu" id="potvrzeniRodicu"
                style="display: inline; width: auto; border: none; margin: 0; cursor: pointer" accept="image/*,.pdf">
                <input type="submit" name="pridatPotvrzeniRodicu" id="pridatPotvrzeniRodicu" value="{t:prihlaska.souhlas_rodicu.odeslat}">
            </form>
            <!-- begin:nahrano -->
            <div style="font-weight: bolder">
                {t:prihlaska.souhlas_rodicu.nahrano} <a href="prihlaska/potvrzeni-rodicu">{t:prihlaska.souhlas_rodicu.zobrazit}</a>
            </div>
            <!-- end:nahrano -->
        </div>
        <!-- end:potvrzeniZakonnyZastupce -->
        <!-- end:prihlasen -->

        <!-- begin:neprihlasen -->
        <p>{neprihlasen}</p>
        <!-- end:neprihlasen -->
    </div>
</div>

<style>
  @keyframes blinker {
    50% {
      opacity: 0;
    }
  }
</style>

<form method="post" class="prihlaska" enctype="multipart/form-data">

    <!----------------------------------------------------------------------------->

    <div class="prihlaska_sekce">
        <h2>{t:prihlaska.predmety.nadpis}</h2>

        <div class="prihlaska_infoPruh">
            <div class="prihlaska_info">
                <img class="prihlaska_infoSymbol" src="soubory/blackarrow/prihlaska/hra.avif"
                     style="top: -40px; right: -19px">
                <h3>GameCon merch</h3>
                <p>{t:prihlaska.predmety.info}<br>
                    {velikostiMikin}<br>
                    <b>{zmenyPredmetuDo}</b></p>
            </div>
            <!-- begin: slevy -->
            <div class="prihlaska_info prihlaska_info-ikona">
                <p>{slevy}</p>
            </div>
            <!-- end: slevy -->
        </div>

        <div class="prihlaska_nahledy"{jazykEshopu}>
            <!-- begin: nahled -->
            <a href="{obrazek}" class="prihlaska_nahled" title="{nazev}" style="display: {display}">
                <img src="{miniatura}">
            </a>
            <!-- end: nahled -->
        </div>

        <div{jazykEshopu}>
            {predmety}
        </div>
    </div>

    <!----------------------------------------------------------------------------->

    <div class="prihlaska_sekce">
        <h2>{t:prihlaska.ubytovani.nadpis}</h2>

        <div class="prihlaska_infoPruh prihlaska_infoPruh-ubytovani">
            <div class="prihlaska_info">
                <img alt="{t:prihlaska.ubytovani.ikona}" class="prihlaska_infoSymbol" src="soubory/blackarrow/prihlaska/mapa.avif"
                     style="top: -33px; right: -15px">
                <h3>{t:prihlaska.ubytovani.info}</h3>
                <ul>
                    <li>{zmenyUbytovaniDo}</li>
                    <li>{t:prihlaska.ubytovani.kapacita}</li>
                    <li>{ubytovaniOdStredy}</li>
                    <!-- begin: ubytovaniMinDveNoci -->
                    <li>{t:prihlaska.ubytovani.min_dve_noci}</li>
                    <!-- end: ubytovaniMinDveNoci -->
                    <!-- begin: poznamkaKUbytovaniVNedeli -->
                    <li>{t:prihlaska.ubytovani.nedele}</li>
                    <!-- end: poznamkaKUbytovaniVNedeli -->
                    <li>{t:prihlaska.ubytovani.snidane}</li>
                    <li>{podrobnostiUbytovani}</li>
                </ul>
            </div>

            <!-- begin: ubytovaniInfoVypravec -->
            <div class="prihlaska_info prihlaska_info-ikona">
                <p>{bonusVypravece}</p>
            </div>
            <!-- end: ubytovaniInfoVypravec -->

            <!-- begin: ubytovaniInfoOrg -->
            <div class="prihlaska_info prihlaska_info-ikona">
                <p>{ubytovaniZdarma}</p>
            </div>
            <!-- end: ubytovaniInfoOrg -->
        </div>

        <div{jazykEshopu}>
            {ubytovani}
        </div>
    </div>

    <!----------------------------------------------------------------------------->

    <div class="prihlaska_sekce">
        <h2>{t:prihlaska.jidlo.nadpis}</h2>

        <div class="prihlaska_infoPruh">
            <div class="prihlaska_info">
                <img class="prihlaska_infoSymbol" src="soubory/blackarrow/prihlaska/rum.avif"
                     style="top: -48px; right: -8px">
                <h3>{t:prihlaska.jidlo.info}</h3>
                <ul>
                    <li>{zmenyJidlaDo}</li>
                    <li>{t:prihlaska.jidlo.vyber} {jidelnicek}</li>
                </ul>
            </div>
        </div>

        <div{jazykEshopu}>
            {jidlo}
        </div>
    </div>

    <!----------------------------------------------------------------------------->

    <div class="prihlaska_sekceObal prihlaska_sekceObal-vstupne">
        <div class="prihlaska_sekce">
            <div class="prihlaska_infoPruh">
                <div class="prihlaska_info">
                    <h3>{t:prihlaska.vstupne.dekujeme}</h3>
                    <p><b>{t:prihlaska.vstupne.prispevky}</b></p>
                </div>
            </div>

            <h2>{t:prihlaska.vstupne.nadpis}</h2>

            <div{jazykEshopu}>
                {vstupne}
            </div>
        </div>
    </div>

    <!----------------------------------------------------------------------------->

    <div class="prihlaska_sekce prihlaska_sekce-zapojit">
        {pomoc}
    </div>

    <!----------------------------------------------------------------------------->

    <div class="prihlaska_sekce">
        <input type="submit" class="formular_primarni" name="prihlasitNeboUpravit" value="{ulozitNeboPrihlasit}">
        <!-- begin:odhlasit -->
        <input type="submit" class="formular_negativni" name="odhlasit" value="{t:prihlaska.odhlasit}"
               onclick="return confirm({potvrzeniOdhlaseni})">
        <!-- end:odhlasit -->
    </div>

    <!----------------------------------------------------------------------------->

</form>

<link rel="stylesheet" href="soubory/blackarrow/_spolecne/baguetteBox.min.css">
<script src="soubory/blackarrow/_spolecne/baguetteBox.min.js"></script>
<script>
  // výchozí filtr odkazů na obrázky nezná AVIF, ve kterém jsou náhledy
  baguetteBox.run('.prihlaska_nahledy', {filter: /.+\.(gif|jpe?g|png|webp|avif)/i})
</script>

<!-- end:prihlaska -->

<!-- begin: prihlaskaPred -->
<div class="prihlaska_hlavickaObal">
    <div class="prihlaska_hlavicka">
        <h1>{t:prihlaska.nadpis}</h1>
        <p>{spusteni}</p>
    </div>
</div>
<!-- end: prihlaskaPred -->

<!-- begin: prihlaskaPo -->
<div class="prihlaska_hlavickaObal">
    <div class="prihlaska_hlavicka">
        <h1>{t:prihlaska.nadpis}</h1>
        <p>{uzavreno}</p>
    </div>
</div>
<!-- end: prihlaskaPo -->

<!-- begin: prihlaskaPoGc -->
<div class="prihlaska_hlavickaObal">
    <div class="prihlaska_hlavicka">
        <h1>{t:prihlaska.nadpis}</h1>
        <!-- begin: ucastnilSe -->
        <p>
            {dekujeme}
            {sledujteNas}
        </p>
        <!-- end: ucastnilSe -->

        <!-- begin: neucastnilSe -->
        <p>
            {neucastnilSe}
        </p>
        <p>
            {fotky}
        </p>
        <!-- end: neucastnilSe -->
    </div>
</div>
<!-- end: prihlaskaPoGc -->

<!-- begin: prihlaskaUzavrena -->
<div class="prihlaska_hlavickaObal">
    <div class="prihlaska_hlavicka">
        <h1>{t:prihlaska.nadpis}</h1>

        <!-- begin: proselInfopultem -->
        <p>{naInfopultu}
            {prehledObjednavek}</p>
        <!-- end: proselInfopultem -->
        <!-- begin: neproselInfopultem -->
        <p>{vitame}</p>
        <!-- end: neproselInfopultem -->
    </div>
</div>

<!-- end: prihlaskaUzavrena -->
