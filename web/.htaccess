Allow from all

AddDefaultCharset   UTF-8
RewriteEngine       On

# Údržbový režim, viz kořenový .htaccess
RewriteCond %{DOCUMENT_ROOT}/maintenance.html -f
RewriteRule ^maintenance\.off\.html$ - [L]
RewriteCond %{DOCUMENT_ROOT}/maintenance.html -f
RewriteRule ^ - [R=503,L]
<If "-f '%{DOCUMENT_ROOT}/maintenance.html'">
    ErrorDocument 503 /maintenance.off.html
</If>
<IfModule mod_headers.c>
    Header always setifempty Retry-After "300" "expr=%{REQUEST_STATUS} == 503"
</IfModule>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule .* index.php?req=$0 [L,QSA]

<IfModule mod_mime.c>
    # typ obrázků nezávisle na tabulce typů té které verze Apache, stejně jako v cache/public/.htaccess
    AddType image/avif .avif
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access 1 year"
    ExpiresByType font/woff "access 1 year"
    ExpiresByType font/ttf "access 1 year"
    ExpiresByType font/otf "access 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/text text/html text/plain text/xml text/css application/x-javascript application/javascript
</IfModule>