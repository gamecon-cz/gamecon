Allow from all

AddDefaultCharset   UTF-8
RewriteEngine       On

# Anglická verze webu (/en/…) má <base href> pod prefixem, takže relativní odkazy na soubory
# (soubory/…, obrázky v obsahu stránek) míří pod /en/. Obsloužíme je stejným souborem jako bez prefixu.
# Adresář en/ neexistuje, proto je REQUEST_FILENAME „…/en" a zbytek cesty bereme z RewriteRule.
RewriteCond %{REQUEST_FILENAME} ^(.+)/en$
RewriteCond %1/$1 -f
RewriteRule ^en/(.+)$ $1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule .* index.php?req=$0 [L,QSA]

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access 1 year"
    ExpiresByType font/woff "access 1 year"
    ExpiresByType font/ttf "access 1 year"
    ExpiresByType font/otf "access 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/text text/html text/plain text/xml text/css application/x-javascript application/javascript
</IfModule>