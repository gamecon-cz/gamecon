RewriteEngine on

# Údržbový režim (dokumentace/nasazeni.md): dokud existuje maintenance.html, dostane každý požadavek 503 se stránkou maintenance.off.html.
# Pravidla se do podsložek s vlastním RewriteEngine nedědí, tentýž blok proto začíná každý takový .htaccess (hlídá to UdrzbovyRezimTest).
# Stránka se podává pod názvem maintenance.off.html, protože adresa /maintenance.html má na serveru Alias na obecnou stránku (ansible, roles/webserver).
# ErrorDocument platí jen za údržby, jinak by přebil tu obecnou stránku, kterou Apache ukáže, když neběží PHP-FPM.
RewriteCond %{DOCUMENT_ROOT}/maintenance.html -f
RewriteRule ^maintenance\.off\.html$ - [L]
RewriteCond %{DOCUMENT_ROOT}/maintenance.html -f
RewriteRule ^ - [R=503,L]
<If "-f '%{DOCUMENT_ROOT}/maintenance.html'">
    ErrorDocument 503 /maintenance.off.html
</If>
<IfModule mod_headers.c>
    Header always setifempty Retry-After "300" "expr=%{REQUEST_STATUS} == 503"
</IfModule>

# Pass Authorization header to PHP (Apache strips it by default for CGI/FPM)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Everything under /symfony/ goes to the Symfony front controller, never to a file of the Symfony tree (config, sources,
# logs), which lies inside the web directory, not even as a PHP script with a path after it. END keeps the rewritten
# request from passing the rules below again.
RewriteRule ^symfony(/|$) symfony/public/index.php [QSA,END,E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Route everything else to legacy web directory
RewriteRule .* web/$0 [L]
